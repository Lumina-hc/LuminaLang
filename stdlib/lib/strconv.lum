use sys::ord as _ord
use sys::chr as _chr
use sys::byte_len as _byte_len
use sys::slice as _slice
use sys::parse_f64 as _parse_f64
use sys::format_f64 as _format_f64

fn itoa(n: i32) string {
    if n == 0 {
        back "0"
    }
    let neg: bool = n < 0
    let m: i32 = n
    if neg {
        m = 0 - m
    }
    let r: string = ""
    while m > 0 {
        let d: i32 = m % 10
        r = _chr(48 + d) + r
        m = m / 10
    }
    if neg {
        r = "-" + r
    }
    back r
}

fn atoi(s: string) i32 {
    let v: i32 = 0
    let neg: bool = false
    let first: bool = true
    for c in s {
        let o: i32 = _ord(c)
        if first {
            first = false
            if o == 45 {
                neg = true
                skip
            }
            if o == 43 {
                skip
            }
        }
        if o >= 48 and o <= 57 {
            v = v * 10 + (o - 48)
        } else {
            halt
        }
    }
    if neg {
        back 0 - v
    }
    back v
}

fn hexdigit(d: i32) string {
    if d < 10 {
        back _chr(48 + d)
    }
    back _chr(87 + d)
}

fn hex(n: i32) string {
    if n < 0 {
        let r: string = ""
        let m: i32 = n
        let i: i32 = 0
        while i < 16 {
            r = hexdigit(m & 15) + r
            m = m >> 4
            i = i + 1
        }
        back "0x" + r
    }
    if n == 0 {
        back "0x0"
    }
    let r: string = ""
    let m: i32 = n
    while m > 0 {
        r = hexdigit(m & 15) + r
        m = m >> 4
    }
    back "0x" + r
}

fn bin(n: i32) string {
    if n < 0 {
        let r: string = ""
        let m: i32 = n
        let i: i32 = 0
        while i < 64 {
            if (m & 1) == 1 {
                r = "1" + r
            } else {
                r = "0" + r
            }
            m = m >> 1
            i = i + 1
        }
        back r
    }
    if n == 0 {
        back "0"
    }
    let r: string = ""
    let m: i32 = n
    while m > 0 {
        if (m & 1) == 1 {
            r = "1" + r
        } else {
            r = "0" + r
        }
        m = m >> 1
    }
    back r
}

fn boolstr(n: i32) string {
    if n != 0 {
        back "true"
    }
    back "false"
}

fn atof(s: string) f64 {
    back _parse_f64(s)
}

fn ftoa(v: f64, prec: i32) string {
    back _format_f64(v, prec)
}

fn fstr(v: f64) string {
    back _format_f64(v, 6)
}

fn from_base(s: string, base: i32) i32 {
    let v: i32 = 0
    let neg: bool = false
    let first: bool = true
    for c in s {
        let o: i32 = _ord(c)
        if first {
            first = false
            if o == 45 {
                neg = true
                skip
            }
            if o == 43 {
                skip
            }
        }
        let d: i32 = 0 - 1
        if o >= 48 and o <= 57 {
            d = o - 48
        } else {
            if o >= 97 and o <= 122 {
                d = o - 87
            } else {
                if o >= 65 and o <= 90 {
                    d = o - 55
                }
            }
        }
        if d >= 0 and d < base {
            v = v * base + d
        } else {
            halt
        }
    }
    if neg {
        back 0 - v
    }
    back v
}

fn parse_hex(s: string) i32 {
    let t: string = s
    let n: i32 = _byte_len(t)
    if n >= 2 {
        let p: string = _slice(t, 0, 2)
        if p == "0x" or p == "0X" {
            t = _slice(t, 2, n)
        }
    }
    back from_base(t, 16)
}
