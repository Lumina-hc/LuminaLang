use io::eprintln
use sys::sin as _sin
use sys::cos as _cos
use sys::tan as _tan
use sys::asin as _asin
use sys::acos as _acos
use sys::atan as _atan
use sys::atan2 as _atan2
use sys::sqrt_f as _sqrt_f
use sys::pow_f as _pow_f
use sys::fabs as _fabs
use sys::ln as _ln
use sys::log10 as _log10
use sys::log2 as _log2
use sys::exp as _exp
use sys::floor as _floor
use sys::ceil as _ceil
use sys::round as _round
use sys::trunc as _trunc
use sys::fmod as _fmod
use sys::hypot as _hypot
use sys::pi as _pi
use sys::e as _e
use sys::tau as _tau

fn abs(v: i32) i32 {
    if v < 0 {
        back 0 - v
    }
    back v
}

fn max(a: i32, b: i32) i32 {
    if a > b {
        back a
    }
    back b
}

fn min(a: i32, b: i32) i32 {
    if a < b {
        back a
    }
    back b
}

fn pow(base: i32, exp: i32) i32 {
    if exp < 0 {
        eprintln("math.pow: negative exponent")
        halt
    }
    let r: i32 = 1
    let i: i32 = 0
    while i < exp {
        r = r * base
        i = i + 1
    }
    back r
}

fn sqrt(n: i32) i32 {
    if n < 0 {
        eprintln("math.sqrt: negative number")
        halt
    }
    let lo: i32 = 0
    let hi: i32 = n + 1
    while lo < hi {
        let mid: i32 = (lo + hi + 1) / 2
        if mid * mid <= n {
            lo = mid
        } else {
            hi = mid - 1
        }
    }
    back lo
}

fn gcd(a: i32, b: i32) i32 {
    let x: i32 = a
    let y: i32 = b
    if x < 0 {
        x = 0 - x
    }
    if y < 0 {
        y = 0 - y
    }
    while y != 0 {
        let t: i32 = x % y
        x = y
        y = t
    }
    back x
}

fn lcm(a: i32, b: i32) i32 {
    if a == 0 or b == 0 {
        back 0
    }
    back (a / gcd(a, b)) * b
}

fn mod(a: i32, b: i32) i32 {
    if b == 0 {
        eprintln("math.mod: division by zero")
        halt
    }
    let r: i32 = a % b
    if r != 0 and ((r < 0) != (b < 0)) {
        r = r + b
    }
    back r
}

fn clamp(v: i32, lo: i32, hi: i32) i32 {
    if v < lo {
        back lo
    }
    if v > hi {
        back hi
    }
    back v
}

fn sign(v: i32) i32 {
    if v > 0 {
        back 1
    }
    if v < 0 {
        back 0 - 1
    }
    back 0
}

fn absdiff(a: i32, b: i32) i32 {
    if a > b {
        back a - b
    }
    back b - a
}

fn sin(x: f64) f64 {
    back _sin(x)
}

fn cos(x: f64) f64 {
    back _cos(x)
}

fn tan(x: f64) f64 {
    back _tan(x)
}

fn asin(x: f64) f64 {
    back _asin(x)
}

fn acos(x: f64) f64 {
    back _acos(x)
}

fn atan(x: f64) f64 {
    back _atan(x)
}

fn atan2(y: f64, x: f64) f64 {
    back _atan2(y, x)
}

fn sqrt_f(x: f64) f64 {
    back _sqrt_f(x)
}

fn pow_f(x: f64, y: f64) f64 {
    back _pow_f(x, y)
}

fn fabs(x: f64) f64 {
    back _fabs(x)
}

fn ln(x: f64) f64 {
    back _ln(x)
}

fn log10(x: f64) f64 {
    back _log10(x)
}

fn log2(x: f64) f64 {
    back _log2(x)
}

fn exp(x: f64) f64 {
    back _exp(x)
}

fn floor(x: f64) f64 {
    back _floor(x)
}

fn ceil(x: f64) f64 {
    back _ceil(x)
}

fn round(x: f64) f64 {
    back _round(x)
}

fn trunc(x: f64) f64 {
    back _trunc(x)
}

fn fmod(x: f64, y: f64) f64 {
