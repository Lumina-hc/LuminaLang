// =============================================
// LuminaLang v0.8.0 新增功能完整测试
// 包含 v0.7.0 没有的所有功能
// =============================================

use io::println
use io::readline
use os::getenv
use os::cwd

// --- bool 类型 ---
fn test_bool_literals() i32 {
    out "=== bool 字面量 ==="
    let flag: bool = true
    out flag
    out false
    back 0
}

fn test_compare_returns_bool() i32 {
    out "=== 比较运算返回 bool ==="
    out 3 > 5
    out 3 < 5
    out 10 == 10
    out "abc" == "abc"
    out "abc" != "def"
    back 0
}

fn is_positive(n: i32) bool {
    back n > 0
}

fn test_bool_as_return_type() i32 {
    out "=== bool 作为返回类型 ==="
    if is_positive(5) {
        out "5 is positive"
    }
    if is_positive(-3) {
        out "should not print"
    } else {
        out "-3 is not positive"
    }
    back 0
}

// --- halt / skip ---
fn test_halt() i32 {
    out "=== halt 测试 ==="
    let i: i32 = 0
    while i < 100 {
        i = i + 1
        if i == 5 {
            halt
        }
    }
    out "should not reach here"
    back 0
}

fn test_skip() i32 {
    out "=== skip 测试 ==="
    let i: i32 = 0
    while i < 5 {
        i = i + 1
        if i == 3 {
            skip  // 跳过本次迭代
        }
        out i    // 输出 1 2 4 5
    }
    back 0
}

// --- for...in 遍历 ---
fn test_forin() i32 {
    out "=== for...in 遍历 ==="
    for ch in "hello" {
        out ch
    }
    back 0
}

// --- 注释语法 ---
fn test_comments() i32 {
    out "=== 注释语法 ==="
    /* 这是多行注释
       可以跨越多行 */
    let x: i32 = 42  // 行内注释
    out x
    back 0
}

// --- os::getenv / os::cwd ---
fn test_os_new() i32 {
    out "=== os::getenv / cwd ==="
    let path: i32 = getenv("PATH")
    out path
    let dir: i32 = cwd()
    out dir
    back 0
}

// --- io::readline ---
fn test_readline() i32 {
    out "=== readline 测试（需手动输入）==="
    out "请输入一行文字:"
    out readline()
    back 0
}

// --- main ---
fn main() i32 {
    test_bool_literals()
    test_compare_returns_bool()
    test_bool_as_return_type()
    test_halt()
    test_skip()
    test_forin()
    test_comments()
    test_os_new()
    test_readline()

    out "=== 全部测试完成 ==="
    back 0
}
